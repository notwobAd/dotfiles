layout {
	background-color "#121318"

    focus-ring {
        active-color "#b1c5ff"
        inactive-color "#8e909d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-gradient   from="#b1c5ff" to="#faabff" angle=45
        inactive-color "#8e909d"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b1c5ff"
        inactive-color "#8e909d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b1c5ff80"
    }
}

overview {
	backdrop-color "#121318"
}

recent-windows {
    highlight {
        active-color "#b1c5ff"
        urgent-color "#ffb4ab"
    }
}
