input {
    disable-power-key-handling
    warp-mouse-to-focus
    focus-follows-mouse
    workspace-auto-back-and-forth

    mod-key "Super"
    mod-key-nested "Alt"

    keyboard {
        xkb {
            layout "us"
            options "caps:swapescape"
        }

        numlock
        repeat-delay 300
        repeat-rate 25
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        accel-speed 0.2
        accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }
}
